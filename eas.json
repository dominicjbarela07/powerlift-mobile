{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "channel": "production",
      "autoIncrement": false,
      "ios": {
        "distribution": "store"
      },
      "android": {
        "distribution": "store"
      }
    },
    "production3-preparation": {
      "channel": "production-3-preparation",
      "autoIncrement": true,
      "env": {
        "STRENGTH_LEDGER_RELEASE_TARGET": "production3",
        "EXPO_PUBLIC_APPROVED_ART_CHANNEL": "production3",
        "EXPO_PUBLIC_ART_RUNTIME_VERSION": "3.0.0",
        "EXPO_PUBLIC_API_BASE": "https://app.strengthledger.fit"
      },
      "ios": {
        "distribution": "store"
      },
      "android": {
        "distribution": "store"
      }
    },
    "testflight31": {
      "channel": "testflight-3-1",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "STRENGTH_LEDGER_RELEASE_TARGET": "testflight31",
        "EXPO_PUBLIC_APPROVED_ART_CHANNEL": "testflight",
        "EXPO_PUBLIC_ART_RUNTIME_VERSION": "3.1.0",
        "EXPO_PUBLIC_API_BASE": "https://app.strengthledger.fit"
      },
      "ios": {
        "distribution": "store"
      }
    },
    "testflight": {
      "channel": "testflight",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://app.strengthledger.fit",
        "EXPO_PUBLIC_APPROVED_ART_CHANNEL": "testflight"
      },
      "ios": {
        "distribution": "store"
      }
    }
  },
  "submit": {
    "testflight31": {
      "ios": {
        "ascAppId": "6756639297"
      }
    },
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6756639297"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6756639297"
      }
    }
  }
}
